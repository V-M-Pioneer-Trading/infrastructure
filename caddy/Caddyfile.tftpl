{
	admin off
	email ${acme_email}
	# Don't open the :80 HTTP->HTTPS redirect listener: agent-service already binds
	# port 80 on this host (they share host networking), so the redirect server
	# would collide and crash-loop Caddy. CloudFront always connects over HTTPS and
	# the cert uses the DNS-01 challenge, so port 80 is never needed here.
	auto_https disable_redirects
}

# The public backend origin. CloudFront is the only thing the security group lets
# reach this host, and it connects here over HTTPS on 443. The certificate is
# issued by Let's Encrypt via the ACME DNS-01 challenge (Route53) — HTTP-01 is
# impossible because port 80 is not open to Let's Encrypt's validators.
#
# {$CADDY_DOMAIN} and {$ORIGIN_VERIFY_SECRET} are Caddy env-var placeholders,
# resolved from the container's environment at start — the secret is never baked
# into this file. The port values are injected by Terraform's templatefile.
{$CADDY_DOMAIN} {
	tls {
		dns route53
		resolvers 1.1.1.1
	}

	# Origin authentication: the prefix list only proves a request came from
	# *some* CloudFront distribution, not ours. Every request must carry the
	# shared secret in X-Origin-Verify (injected by our distribution as an origin
	# custom header). Anything else — including a stranger pointing their own
	# distribution at this host — gets 403 before reaching a backend.
	@unverified not header X-Origin-Verify {$ORIGIN_VERIFY_SECRET}

	# Wrapped in `route` so directives execute in written order: the 403 guard must
	# run BEFORE the handle blocks. Without route, a `handle` (which is terminal)
	# matches and serves the request first under Caddy's default directive order,
	# and the guard never fires — origin auth fails open. Verified by an
	# unauthenticated request returning 200 instead of 403.
	route {
		respond @unverified "Forbidden" 403

		# Path prefixes match the CloudFront cache-behavior patterns exactly.
		# handle (not handle_path) preserves the full path, because each service
		# self-mounts under its own /api/<service>/... prefix.
		#
		# Two different backend-addressing schemes below, per increment 3 Stage
		# 4 / auth-design.md decision 9: navigation/agent/fleet/automation stay
		# on --network host, so Caddy (now on the authnet bridge) reaches them
		# via the Docker host-gateway address, not localhost — localhost from
		# inside a bridge-networked container means the container itself.
		# auth-service is on authnet too, so it's reached by ordinary bridge DNS
		# (its container name) instead.
		handle /api/navigation/* {
			reverse_proxy host.docker.internal:${navigation_port}
		}
		handle /api/agent/* {
			reverse_proxy host.docker.internal:${agent_port}
		}
		handle /api/fleet/* {
			reverse_proxy host.docker.internal:${fleet_port}
		}
		handle /api/automation/* {
			reverse_proxy host.docker.internal:${automation_port}
		}
		# st-gateway is internal-only; only its unauthenticated health probe is
		# routed. It's on authnet too (decision 9), so bridge DNS, not the
		# host-gateway address used for the four services above.
		handle /api/st-gateway/health {
			reverse_proxy st-gateway:${gateway_port}
		}

		# auth-service (decision 9): only these three paths, and specifically
		# never /auth/v1/token at any method — that's the one route that can
		# return a token, and it must stay authnet-internal, reachable only by
		# st-gateway directly. Bridge DNS, same reasoning as st-gateway above.
		handle /api/auth/v1/status {
			reverse_proxy auth-service:${auth_port}
		}
		handle /api/auth/v1/agent-token {
			reverse_proxy auth-service:${auth_port}
		}
		handle /api/auth/v1/register {
			reverse_proxy auth-service:${auth_port}
		}
		# Liveness only, same public /api/<service>/health convention as the
		# four services above — no token, no state, nothing gated. Needed
		# explicitly because the routes above are exact paths rather than an
		# /api/auth/* prefix, and a prefix here would expose /api/auth/v1/token.
		handle /api/auth/health {
			reverse_proxy auth-service:${auth_port}
		}

		handle {
			respond "Not Found" 404
		}
	}
}
